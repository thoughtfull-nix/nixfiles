group-by=app-name
max-history=100
on-notify=exec mpv @notify@
background-color=#3584e4
border-color=#1c71d8
border-size=4
text-color=#ffffff
progress-color=#1c71d8

[app-name=dnd]
invisible=0
default-timeout=3000
group-by=none

[mode=dnd]
invisible=1
on-notify=none

[app-name=dnd]
invisible=0

# Notifications that should not play sound (user-initiated actions)
[category=no-sound]
on-notify=none

[app-name=speaker-status]
on-notify=none
border-size=0

[app-name=mic-status]
on-notify=none
border-size=0

[app-name=brightness-status]
on-notify=none
border-size=0

# iwmenu (waybar-network-wifi-menu) fires a desktop notification for every
# network action (connect, disconnect, adapter power, etc.) with no CLI
# flag to disable them, so suppress them outright here instead.
[app-name=iwmenu]
invisible=1
on-notify=none

[urgency=high]
background-color=#c01c28
border-color=#c01c28
